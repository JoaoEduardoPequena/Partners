{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error",
      "System": "Error"
    }
  },

  // SQL Server LocalDB com autenticação Windows — sem utilizador/password.
  // Para outro servidor, usar user-secrets ou a variável de ambiente ConnectionStrings__Connection.
  "ConnectionStrings": {
    "Connection": "Server=(localdb)\\MSSQLLocalDB;Database=Partners;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "DemoData": {
    "SeedOnStartup": true
  }
}
